{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    // TanStack Start discovers global request middleware by convention.
    "src/start.ts",
    // Nitro plugins, named by path in vite.config.ts.
    "src/shared/server/comfy-boot.ts",
    "src/app/boot.ts",
    // Run by hand or from CI, not imported.
    "scripts/*.mjs",
    // Compile-time route inference tripwire; only tsgo reads it.
    "tests/type-contracts.ts",
    // Run by the Playwright web server command before the dev server starts.
    "tests/e2e/seed.ts",
    // Feature-local tests: `npm run test:server` and Playwright find them by these globs.
    "src/features/*/server/**/*.test.ts",
    "src/shared/server/**/*.test.ts",
    "src/features/*/tests/*.test.ts",
    "src/features/*/tests/*.spec.ts",
  ],
  // The vendored plugin is upstream source, as in oxlint.config.ts.
  "ignorePatterns": ["tools/oxlint/anti-slop/**"],
  // Imported only by that vendored plugin.
  "ignoreDependencies": ["@oxlint/plugins"],
  // shadcn components are added whole by `npx shadcn add`; an unused component file still fails.
  "ignoreExports": [{ "file": "src/components/ui/**", "exports": ["*"] }],
}
