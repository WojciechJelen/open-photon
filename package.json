{
	"name": "comfy-start-spike",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3030",
		"generate-routes": "tsr generate",
		"build": "npm run typecheck && vite build",
		"start": "node .output/server/index.mjs",
		"typecheck": "npm run generate-routes && tsc --noEmit",
		"check": "biome check .",
		"format": "biome check --write .",
		"test:e2e": "playwright test",
		"test:server": "node --experimental-strip-types --test tests/stream.test.ts"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-router": "1.170.45",
		"@tanstack/react-start": "1.169.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cn": "^0.5.0",
		"lucide-react": "^0.577.0",
		"nitro": "3.0.260610-beta",
		"radix-ui": "^1.8.1",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwind-merge": "^3.0.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.3.6",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@playwright/test": "^1.64.1",
		"@tanstack/router-cli": "^1.132.0",
		"@types/node": "^24.19.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"typescript": "^6.0.2",
		"vite": "^8.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss"
		]
	},
	"version": "0.1.0",
	"engines": {
		"node": ">=24"
	}
}
