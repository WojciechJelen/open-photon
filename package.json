{
  "name": "open-photon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3030",
    "build": "npm run typecheck && vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsgo --noEmit",
    "tsc": "npm run typecheck",
    "lint": "oxlint --type-aware",
    "lint:format": "oxfmt --check",
    "lint:fallow": "fallow dead-code && fallow dupes --fail-on-issues",
    "check": "npm-run-all --parallel tsc lint lint:format lint:fallow",
    "format": "oxfmt",
    "fix": "oxlint --fix --type-aware && oxfmt && npm run typecheck",
    "test:e2e": "playwright test",
    "test:server": "node --experimental-strip-types --test tests/*.test.ts",
    "check:client": "node scripts/check-client-secrets.mjs",
    "check:privacy": "node scripts/check-private-files.mjs"
  },
  "dependencies": {
    "@comfyorg/sdk": "^0.5.0",
    "@fastify/busboy": "^3.2.3",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "srvx": "1.0.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.88.0",
    "@playwright/test": "^1.64.1",
    "@shadcn/lint": "^0.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.0.1",
    "fallow": "3.34.1",
    "nitro": "3.0.260610-beta",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.6.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
